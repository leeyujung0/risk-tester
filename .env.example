# 한국투자증권(KIS) Open API 연동용 환경변수.
# 이 두 값을 설정하면 defaultDataProvider(lib/engine/dataProvider.ts)가
# 자동으로 KIS 실데이터를 우선 사용하고, 실패한 종목만 CSV/목업으로 폴백한다.
# 설정하지 않으면 기존 방식(CSV 있으면 CSV, 없으면 목업)대로 동작한다.

# KIS 개발자센터(https://apiportal.koreainvestment.com)에서 앱 등록 후 발급받는 값.
KIS_APP_KEY=
KIS_APP_SECRET=
GEMINI_API_KEY=

# 세션 서명 키 (운영 환경에서는 반드시 충분히 긴 랜덤 값으로 변경)

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud Console OAuth 2.0 클라이언트 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DART_API_KEY=

# 선택. 기본값은 실전투자 도메인. 모의투자 계좌로 테스트하려면 아래 주석 해제:
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# 선택. 사전에 다운로드한 과거 시세 CSV 경로 (date,ticker,close 형식).
# 지정하지 않으면 data/prices.csv를 기본으로 찾는다.
# PRICE_CSV_PATH=./data/prices.csv
